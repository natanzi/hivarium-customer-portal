{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hivarium-customer-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/service/*"]
  },
  "d1_databases": [
    {
      "binding": "PORTAL_DB",
      "database_name": "hivarium-customer-portal",
      "database_id": "92f5fed1-be18-4f82-8ac9-ae217a0789fe"
    }
  ],
  // Internal Worker-to-Worker service bindings. Authentication is still
  // enforced independently with directional bearer-token secrets.
  "services": [
    { "binding": "OPERATOR_SERVICE", "service": "hivarium-operator-console" },
    { "binding": "LICENSE_SERVICE", "service": "hivarium-license-service" }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
