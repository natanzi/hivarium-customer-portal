{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hivarium-customer-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/service/*"]
  },
  "d1_databases": [
    {
      "binding": "PORTAL_DB",
      "database_name": "hivarium-customer-portal",
      "database_id": "92f5fed1-be18-4f82-8ac9-ae217a0789fe"
    }
  ],
  // Service bindings for internal services (see docs/internal-service-contracts.md).
  // Keep commented out until the Operator Console / License Service workers are
  // deployed and accept the portal's service credential. While absent, the
  // related portal sections fail closed with a safe unavailable response.
  // "services": [
  //   { "binding": "OPERATOR_SERVICE", "service": "hivarium-operator-console" },
  //   { "binding": "LICENSE_SERVICE", "service": "hivarium-license-service" }
  // ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
