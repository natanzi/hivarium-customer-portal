{
  "name": "hivarium-customer-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:worker": "vitest run --project worker",
    "test:components": "vitest run --project components",
    "test:e2e": "npm run build && playwright test",
    "db:seed:dev": "wrangler d1 execute PORTAL_DB --local --file scripts/seed-dev.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "^7.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^30.0.1",
    "miniflare": "^5.20260911.0-alpha",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.0",
    "wrangler": "4.131.1"
  }
}
